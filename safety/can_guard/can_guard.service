# can_guard systemd 유닛 (초안, 미설치) — §7.2 "생존성" 규칙을 그대로 옮긴 것.
# 설치 전 확인할 것: ExecStart 경로, WatchdogSec 값(can_guard.py 의 sd_notify 주기와 맞춰야 함 — 아직 미구현),
# 실행 계정의 rtprio/memlock ulimit(A-3 처럼 sudo chrt 로 상속시킬지, 이 유닛 전용으로 CAP_SYS_NICE 를
# AmbientCapabilities 로 줄지는 별도 결정 — can_stack_development.md §5.C 의 A-3 결론 참고).
#
# 설치(아직 하지 말 것 — 팀 확인 후):
#   sudo cp can_guard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now can_guard.service

[Unit]
Description=A1-BSW can_guard — 안전 임계 CAN TX (0x156/0x157), MCU 대체 (§7)
# 다른 어떤 서비스보다 먼저 떠서 안전 상태(En=0)로 대기해야 한다(§7.2 Startup 규칙).
DefaultDependencies=no
After=local-fs.target

[Service]
Type=notify
# TODO: can_guard.py 가 sd_notify(READY=1) 와 주기적 WATCHDOG=1 을 아직 안 보낸다(남은 작업) — 그 전엔
# Type=simple 로 두고 테스트할 것. WatchdogSec 은 그 하트비트 주기의 2~3배가 관례.
WatchdogSec=200ms
Restart=always
RestartSec=100ms
ExecStart=/usr/bin/python3 /home/ailab/git/A1-BSW/safety/can_guard/can_guard.py
# perception 이 OOM 을 먼저 맞도록 — guard 는 마지막까지 살아남는 쪽.
OOMScoreAdjust=-1000
# A-3 레시피: 격리 코어 배치(taskset)·SCHED_FIFO 90·mlockall 은 can_guard.py 자체(rt_utils 상당)가 프로세스
# 시작 시점에 스스로 건다(eait_tx.py 의 apply_rt_setup 패턴과 동일) — 유닛에서 CPUAffinity= 로 이중 지정하지
# 않는다(단일 소스: 코드).
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
