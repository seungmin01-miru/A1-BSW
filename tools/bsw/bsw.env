# tools/bsw 기본값 — bsw_up.sh 가 읽는다. 현장에서 바꿀 땐 이 파일이 아니라 명령줄 옵션으로(기록이 세션 폴더에 남음).
# 값의 근거: CLAUDE.md 1.4(안전), ros2_ws/src/a1_control_adapter/config/track.yaml(acc_max_pct 100), 11-04 자율 주행 설정.

BSW_CAN=kvaser          # kvaser | peak | sil
BSW_KV_CH=0             # Kvaser Leaf CANlib 채널 (대회 차량 PC = 0)
BSW_PEAK_IF=can0        # --peak 일 때 SocketCAN 이름
BSW_ACC_LIMIT=100       # can_guard --acc-limit-pct. 정지 출발 문턱이 70–80 % 라 30 이면 출발 못 함(11-04)
BSW_APP_REQUIRED=1      # 1 = 핸드폰 앱(0x156/0x157)이 안 보이면 can_guard 시작 거부(앱 = 원격 인수·비상 정지 수단)
BSW_AUTO_ARM=1          # 1 = 모델 /control/target 0.3 s 신선 → 자동 arm(1회). 0 = arm 서비스로 직접
BSW_RT=1                # 1 = can_guard 격리 코어 8·SCHED_FIFO 90 (sudo 비밀번호 1회)
BSW_UI=1                # 1 = 상태판 창(bsw_monitor.py)을 함께 띄움(nice 10, 격리 코어 밖 — CPU 약 3 %·1코어, 2026-11-06 측정). 0 = 안 띄움(--no-ui)
BSW_CAPTURE=$HOME/a1_race_capture   # 세션 폴더 상위
BSW_STOP_KPH=1.0        # bsw_down.sh: 이 속도보다 빠르면 끄지 않음(--force 로 무시)

# 경기 모드(--race) 옵션 묶음 - 계획서(docs/2026-11-06_race_flag_dev_plan.md) 10절. race_args.sh 가 can_guard 옵션으로 바꾼다.
# 값은 can_guard 기본값과 같지만 일부러 전부 적어 넘긴다(그날 쓴 값이 SESSION.md 에 그대로 남는다 - 이의제기 증거, R-09).
# 그날만 바꿀 땐 이 파일이 아니라 --race-opt "--pre-go-brake-pct 20" 처럼 명령줄로. 빈 값 = 옵션을 넘기지 않음.
BSW_RACE_ADAPTER_HOLD_AFTER_S=0.10   # 어댑터 track.yaml hold_after_s 와 같은 값이어야 함(다르면 bsw_up 이 시작 거부)
BSW_RACE_CONFIRM_FRAMES=2            # 확정, D12
BSW_RACE_STOP_ACTION=estop           # 잠정, 질의서 4
BSW_RACE_SIGNAL_TIMEOUT_S=0          # 잠정, 질의서 5. 0 = 0x124 끊김은 기록만
BSW_RACE_RESUME_MODE=restart         # 잠정, 질의서 6. restart | go-reset
BSW_RACE_RES_ALIVE_TIMEOUT_S=0.5     # 잠정, 업체 1-6
BSW_RACE_PRE_GO_BRAKE_PCT=30         # 잠정, 풀림 시간 실측 후 최소값(race_flag_vehicle_test_plan.md 1)
BSW_RACE_SLOW_TARGET_KPH=8.0         # 서행 1단계(6.3절). 단계 변경은 사람 승인 후
BSW_RACE_SLOW_ACC_CUT_KPH=8.8
BSW_RACE_SLOW_BRAKE_KPH=9.3
BSW_RACE_FINISH_CAP_KPH=20           # 잠정, 질의서 7-3
BSW_RACE_PARKED_SPEED_KPH=0.5        # 잠정
BSW_RACE_PARKED_AFTER_S=5            # 잠정
BSW_RACE_PARKED_BRAKE_PCT=60         # 잠정
BSW_RACE_INPUT_GRACE_S=1.0           # 확정, D7
BSW_RACE_RECOVER_BUDGET_M=0.30       # 확정, D3
BSW_RACE_RECOVER_DELAY_S=0.25        # 잠정
BSW_RACE_RECOVER_ALAT_MAX=3.0        # 잠정
BSW_RACE_TRACK_MIN_RADIUS_M=         # 잠정, 모델 팀 5-1 답 전에는 빈 값(복구 허용 약 0.2 s ★)
BSW_RACE_RESUME_LOW_SPEED=0          # 1 = --resume-low-speed. 8.3: SIL·저속 실차 통과 후 사람이 켠다
BSW_RACE_SPEED_LIMIT_TX=0            # 1 = 0x203 송신. 대회측 허락(질의서 9-1) 전에는 켜지 않는다
BSW_RACE_SPEED_LIMIT_RELEASE_KPH=    # 0x203 해제값. 업체 답 전까지 비움 - 지어내지 않는다
BSW_RACE_SPEED_LIMIT_PRACTICE_KPH=30
BSW_RACE_SPEED_LIMIT_FAST_PERIOD=0.02
BSW_RACE_SPEED_LIMIT_KEEP_PERIOD=0.1
BSW_RACE_SPEED_LIMIT_CONFIRM_FRAMES=3
BSW_RACE_SPEED_LIMIT_MISMATCH_S=0.3
BSW_RACE_SPEED_LIMIT_RELEASE_NOTE_S=1.0
BSW_RACE_SPEED_LIMIT_STARTUP_TIMEOUT=2.0
BSW_RACE_MIN_MODEL_S=10              # bsw_status 시작 점검: 모델 정상 이만큼 이상이면 통과(계획서 WP8)
